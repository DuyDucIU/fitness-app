// Schema ban đầu (MVP). Các bảng còn lại của SDD 7.1 thêm dần theo từng tính năng.
// Tên bảng/cột dùng snake_case khớp ERD (SDD 7.1) qua @@map/@map.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  /// Partial unique index: mỗi user tối đa một routine đang dùng.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UnitPref {
  kg
  lb
}

enum DumbbellLoad {
  per_dumbbell
  total
}

enum Mechanic {
  compound
  isolation
}

enum MetricType {
  weight_reps
  reps
  duration
  distance
}

enum ExerciseSource {
  free_exercise_db @map("free-exercise-db")
  curated
  user
}

enum MuscleRole {
  primary
  secondary
}

enum AliasLang {
  vi
  en
}

/// Quy ước ghi tạ (SRS Phụ lục B), snapshot ở SESSION_EXERCISES.load_input.
enum LoadInput {
  total
  per_side
  per_dumbbell
  stack
  added_weight
}

/// Nguồn của routine (ROUTINES.source). `import_*` là post-MVP, chưa ghi.
enum RoutineSource {
  manual
  program
  import_text
  import_image
  import_video
}

enum SetType {
  warmup
  working
  drop
  failure
}

/// Loại gợi ý (SUGGESTIONS.kind).
enum SuggestionKind {
  increase
  celebrate
  back_off
  return_from_break
  deload
}

enum SuggestionStrength {
  soft
  strong
}

/// Trạng thái gợi ý: tỉ lệ chấp nhận (metric của engine) tính trên cột này.
enum SuggestionStatus {
  pending
  accepted
  dismissed
  expired
}

/// Loại chỉ số cơ thể (BODY_METRICS.metric). Cân nặng lưu kg, vòng eo cm, body fat %.
enum BodyMetricKind {
  weight
  waist
  body_fat
}

/// Nguồn chỉ số cơ thể. `health_connect` là post-MVP (UC29), chưa ghi.
enum BodyMetricSource {
  manual
  health_connect
}

/// Ngôn ngữ giao diện (D27, SDD 3.5). Tiếng Anh là mặc định.
enum Locale {
  en
  vi
}

model User {
  id                  String        @id @default(uuid()) @db.Uuid
  email               String        @unique
  authProvider        String        @map("auth_provider")
  authSubject         String        @unique @map("auth_subject")
  displayName         String?       @map("display_name")
  unitPref            UnitPref      @default(kg) @map("unit_pref")
  locale              Locale        @default(en)
  /// Ranh giới tuần cho streak (UC16)
  timezone            String        @default("Asia/Ho_Chi_Minh")
  rpeEnabled          Boolean       @default(false) @map("rpe_enabled")
  dumbbellLoadDefault DumbbellLoad? @map("dumbbell_load_default")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt           DateTime?     @map("deleted_at") @db.Timestamptz(6)

  exercises        Exercise[]
  aliases          ExerciseAlias[]
  workoutSessions  WorkoutSession[]
  routines         Routine[]
  suggestions      Suggestion[]
  bodyMetrics      BodyMetric[]
  exerciseSettings UserExerciseSetting[]

  @@map("users")
}

model Muscle {
  id          Int    @id @default(autoincrement())
  /// Mã chuẩn hoá, vd "lats", "traps"
  code        String @unique
  nameEn      String @map("name_en")
  nameVi      String @map("name_vi")
  /// chest, back, legs...
  muscleGroup String @map("muscle_group")

  exercises ExerciseMuscle[]

  @@map("muscles")
}

model Exercise {
  id         String         @id @default(uuid()) @db.Uuid
  /// null = catalog chung
  ownerId    String?        @map("owner_id") @db.Uuid
  nameEn     String         @map("name_en")
  nameVi     String?        @map("name_vi")
  equipment  String?
  mechanic   Mechanic?
  metricType MetricType     @default(weight_reps) @map("metric_type")
  source     ExerciseSource
  sourceRef  String?        @map("source_ref")
  license    String?
  isArchived Boolean        @default(false) @map("is_archived")

  owner            User?                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  muscles          ExerciseMuscle[]
  aliases          ExerciseAlias[]
  sessionExercises SessionExercise[]
  routineExercises RoutineExercise[]
  userSettings     UserExerciseSetting[]

  @@unique([source, sourceRef])
  @@map("exercises")
}

model ExerciseMuscle {
  exerciseId String     @map("exercise_id") @db.Uuid
  muscleId   Int        @map("muscle_id")
  role       MuscleRole

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscle   Muscle   @relation(fields: [muscleId], references: [id])

  @@id([exerciseId, muscleId])
  @@map("exercise_muscles")
}

model ExerciseAlias {
  id              String    @id @default(uuid()) @db.Uuid
  exerciseId      String    @map("exercise_id") @db.Uuid
  /// null = alias chung, có giá trị = alias user tự đặt
  ownerId         String?   @map("owner_id") @db.Uuid
  alias           String
  /// Không dấu, chữ thường — dùng cho tìm kiếm (UC03)
  aliasNormalized String    @map("alias_normalized")
  lang            AliasLang

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  owner    User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([aliasNormalized(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("exercise_aliases")
}

// Routine (UC05, SDD 7.1): ghi bằng REST, cần mạng (ADR 0002); app cache chỉ đọc. Xoá
// routine là đặt `archived_at` (giữ để lịch sử còn tên ngày tập); xoá ngày tập hay bài
// trong ngày là xoá hẳn. Xoá user thì xoá theo cascade.

model Routine {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  /// Id trong YAML của program đã chép (UC24), không phải khoá ngoại
  programId  String?       @map("program_id")
  name       String
  source     RoutineSource
  isActive   Boolean       @default(false) @map("is_active")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt DateTime?     @map("archived_at") @db.Timestamptz(6)

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  days RoutineDay[]

  /// Mỗi user tối đa một routine đang dùng (GLOSSARY › Routine đang dùng)
  @@unique([userId], map: "routines_one_active_per_user", where: raw("is_active"))
  @@index([userId])
  @@map("routines")
}

model RoutineDay {
  id        String @id @default(uuid()) @db.Uuid
  routineId String @map("routine_id") @db.Uuid
  /// vd "Push A", "Leg day"
  name      String
  position  Int

  routine   Routine           @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]

  @@index([routineId])
  @@map("routine_days")
}

model RoutineExercise {
  id                 String   @id @default(uuid()) @db.Uuid
  routineDayId       String   @map("routine_day_id") @db.Uuid
  exerciseId         String   @map("exercise_id") @db.Uuid
  position           Int
  supersetGroup      Int?     @map("superset_group")
  targetSets         Int      @map("target_sets")
  /// Tạ khởi điểm tĩnh (R8): từ routine, program hoặc import
  initialWeightKg    Decimal? @map("initial_weight_kg") @db.Decimal
  /// null = theo luật mặc định
  warmupEnabled      Boolean? @map("warmup_enabled")
  repMin             Int?     @map("rep_min")
  repMax             Int?     @map("rep_max")
  /// Bài đo thời gian
  targetDurationMinS Int?     @map("target_duration_min_s")
  targetDurationMaxS Int?     @map("target_duration_max_s")
  targetRpe          Decimal? @map("target_rpe") @db.Decimal
  restSeconds        Int      @map("rest_seconds")
  /// double | linear | percent_1rm (chưa dùng ở MVP)
  progressionScheme  String?  @map("progression_scheme")
  progressionParams  Json?    @map("progression_params")
  notes              String?

  day      RoutineDay @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  /// Cascade: xoá user thì bài tuỳ chỉnh và routine dùng bài đó cùng bị xoá, thứ tự nào cũng được.
  exercise Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([routineDayId])
  @@map("routine_exercises")
}

// Dữ liệu buổi tập (SDD 7.1), local-first: id sinh ở client, app đẩy lên qua outbox
// (POST /v1/sync/push, upsert idempotent theo id). `updated_at` do server đặt mỗi lần
// ghi (cursor của pull); xoá bằng tombstone `deleted_at`. Xoá user thì xoá theo cascade.

model WorkoutSession {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// null = tập tự do. Cố ý không có khoá ngoại sang routine_days (SDD 7.2): buổi ghi
  /// offline có thể đẩy lên sau khi ngày tập đã bị xoá; id không tra ra coi như tập tự do.
  routineDayId     String?   @map("routine_day_id") @db.Uuid
  startedAt        DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt          DateTime? @map("ended_at") @db.Timestamptz(6)
  notes            String?
  /// Id bản ghi đã ghi sang Health Connect (post-MVP)
  healthExternalId String?   @map("health_external_id")
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises SessionExercise[]

  @@index([userId, updatedAt])
  /// "Lần trước" của user (SDD 7.2)
  @@index([userId, startedAt(sort: Desc)])
  @@map("workout_sessions")
}

model SessionExercise {
  id                String    @id @db.Uuid
  sessionId         String    @map("session_id") @db.Uuid
  /// Khoá ngoại DEFERRABLE INITIALLY DEFERRED (migration defer_session_exercise_fk, viết
  /// tay): xoá user thì bài tuỳ chỉnh và buổi tập dùng bài đó cùng bị xoá theo cascade.
  exerciseId        String    @map("exercise_id") @db.Uuid
  /// null = bài ad hoc. Cố ý không có khoá ngoại sang routine_exercises, như
  /// `workout_sessions.routine_day_id` (SDD 7.2).
  routineExerciseId String?   @map("routine_exercise_id") @db.Uuid
  loadInput         LoadInput @map("load_input")
  position          Int
  supersetGroup     Int?      @map("superset_group")
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: NoAction)
  sets     SetLog[]

  @@index([sessionId])
  /// "Lần trước" của một bài (SDD 7.2)
  @@index([exerciseId])
  @@map("session_exercises")
}

model SetLog {
  id                String    @id @db.Uuid
  sessionExerciseId String    @map("session_exercise_id") @db.Uuid
  setIndex          Int       @map("set_index")
  setType           SetType   @map("set_type")
  /// Đúng con số user nhập, theo load_input của bài và input_unit
  weightValue       Decimal?  @map("weight_value") @db.Decimal
  inputUnit         UnitPref? @map("input_unit")
  reps              Int?
  durationS         Int?      @map("duration_s")
  distanceM         Decimal?  @map("distance_m") @db.Decimal
  rpe               Decimal?  @db.Decimal
  completedAt       DateTime  @map("completed_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@index([sessionExerciseId])
  @@map("set_logs")
}

// Gợi ý của progression engine (UC12, UC13), local-first qua outbox như dữ liệu buổi tập.
// Cố ý không có khoá ngoại sang bài tập, ngày tập hay buổi tập (như SDD 7.2): gợi ý ghi
// offline có thể đẩy lên sau khi các bản ghi đó đã bị xoá. Xoá user thì xoá theo cascade.

model Suggestion {
  id                       String             @id @db.Uuid
  userId                   String             @map("user_id") @db.Uuid
  /// Bài được gợi ý, kể cả bài ad hoc
  exerciseId               String             @map("exercise_id") @db.Uuid
  /// null = bài ad hoc
  routineExerciseId        String?            @map("routine_exercise_id") @db.Uuid
  /// null = gợi ý trước buổi
  sessionExerciseId        String?            @map("session_exercise_id") @db.Uuid
  /// Lần tập gần nhất của bài làm căn cứ: cùng căn cứ là cùng một gợi ý
  basedOnSessionExerciseId String?            @map("based_on_session_exercise_id") @db.Uuid
  kind                     SuggestionKind
  strength                 SuggestionStrength
  /// Tham số của lý do (số set, rep range, mức tạ…)
  payload                  Json
  /// Mã lý do (vd all_sets_top); câu chữ dựng ở client
  reason                   String
  status                   SuggestionStatus
  createdAt                DateTime           @map("created_at") @db.Timestamptz(6)
  respondedAt              DateTime?          @map("responded_at") @db.Timestamptz(6)
  updatedAt                DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?          @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("suggestions")
}

// Cài đặt riêng từng bài (UC08, UC14), local-first qua outbox: app đẩy cả dòng, upsert theo
// khoá user × bài, last-write-wins. `updated_at` do server đặt (cursor của pull). Không xoá
// dòng nên không có tombstone. Xoá user hay bài tuỳ chỉnh thì xoá theo cascade.

model UserExerciseSetting {
  userId        String    @map("user_id") @db.Uuid
  exerciseId    String    @map("exercise_id") @db.Uuid
  /// Bậc tạ (kg) cho nút −/+ và các gợi ý có số
  weightStepKg  Decimal   @map("weight_step_kg") @db.Decimal
  /// Quy ước ghi tạ cho các buổi sau; bài trong buổi chụp lại ở session_exercises.load_input
  loadInput     LoadInput @map("load_input")
  /// null = không có đòn
  barWeightKg   Decimal?  @map("bar_weight_kg") @db.Decimal
  restAutoStart Boolean   @default(true) @map("rest_auto_start")
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseId])
  @@index([userId, updatedAt])
  @@map("user_exercise_settings")
}

// Chỉ số cơ thể (UC18): ghi bằng REST, cần mạng (ADR 0002), không đi qua outbox nên xoá là
// xoá hẳn. Xoá user thì xoá theo cascade.

model BodyMetric {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  metric     BodyMetricKind
  value      Decimal          @db.Decimal
  measuredAt DateTime         @map("measured_at") @db.Timestamptz(6)
  source     BodyMetricSource
  /// Id bản ghi bên Health Connect để khử trùng khi đồng bộ (post-MVP)
  externalId String?          @map("external_id")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Lần sửa số hoặc thời điểm gần nhất; null = chưa sửa
  editedAt   DateTime?        @map("edited_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId])
  @@index([userId, measuredAt(sort: Desc)])
  @@map("body_metrics")
}
