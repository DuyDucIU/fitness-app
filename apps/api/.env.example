# Copy thành .env (không commit). API chạy trên máy, Postgres chạy bằng Docker Compose.
NODE_ENV=development
PORT=3000

# Khớp với biến POSTGRES_* trong .env ở thư mục gốc
DATABASE_URL="postgresql://fitness:fitness@localhost:5432/fitness?schema=public"

# Supabase Auth (cloud) — lấy ở Project Settings > API. Chỉ cần URL, không dùng service_role key.
SUPABASE_URL=
# Chỉ điền nếu project dùng JWT secret chung (HS256); để trống thì verify bằng JWKS.
SUPABASE_JWT_SECRET=

# Origin của web app được phép gọi API (CORS), cách nhau bằng dấu phẩy. Mặc định: Vite dev (5173) + preview (4173, để thử service worker).
# Khi demo qua host HTTPS/tunnel, thêm URL đó vào đây (SDD 4.4).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
