# Copy thành .env (không commit). Biến VITE_* được nhúng vào bundle — không đặt khoá bí mật.

# URL API. Mặc định: API chạy trên máy. Khi demo qua tunnel/host HTTPS, đổi sang URL đó (SDD 4.4)
# và thêm origin của web app vào CORS_ORIGINS trong apps/api/.env.
VITE_API_URL=http://localhost:3000/v1

# Supabase Auth (cloud) — Project Settings > API: URL và publishable key (KHÔNG dùng service_role key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
