{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "app_update_title": "Update ready",
  "app_update_body": "Reloads the app in a second. Nothing you logged is lost.",
  "app_update_after_workout": "It installs after you finish this workout.",
  "app_updated": "Updated.",
  "common_back": "Back",
  "common_cancel": "Cancel",
  "common_close": "Close",
  "common_save": "Save",
  "common_retry": "Try again",
  "common_options_for": "Options for {name}",
  "common_update": "Update",
  "nav_main": "Main",
  "nav_today": "Today",
  "nav_plans": "Plans",
  "nav_history": "History",
  "nav_progress": "Progress",
  "nav_me": "Me",
  "sync_synced": "Synced",
  "sync_syncing": "Syncing…",
  "sync_pending": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} pending",
        "countPlural=other": "{count} pending"
      }
    }
  ],
  "sync_offline": "Offline",
  "sync_offline_pending": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Offline · {count} change",
        "countPlural=other": "Offline · {count} changes"
      }
    }
  ],
  "sync_offline_hint": "Offline. Everything you log is saved on this device.",
  "sync_offline_pending_hint": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} change saved on this device, waiting for a connection",
        "countPlural=other": "{count} changes saved on this device, waiting for a connection"
      }
    }
  ],
  "me_language": "Language",
  "error_validation_failed": "Some of that didn’t look right. Check and try again.",
  "error_unauthorized": "Signed out. Sign in again any time to pick up where you left off.",
  "error_not_found": "That’s no longer here.",
  "error_internal_server_error": "Something went wrong on our side. Your data on this device is safe.",
  "error_network": "No connection. Try again when you’re connected.",
  "error_unknown": "Something went wrong. Try again.",
  "resume_in_progress": "{name} · in progress",
  "resume_sets_logged": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} set logged",
        "countPlural=other": "{count} sets logged"
      }
    }
  ],
  "resume_action": "Resume",
  "resume_label": "Workout in progress: {name}, {elapsed}. Resume"
}
